{
  "name": "astralcanvas",
  "version": "0.1.0",
  "private": true,
  "description": "AstralCanvas — multilingual AI horoscope experience with a pre-generated content bank and interactive zodiac scene",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "content:generate": "tsx src/scripts/generate-content.ts",
    "content:validate": "tsx src/scripts/validate-content.ts",
    "content:import": "tsx src/scripts/import-content.ts",
    "content:export": "tsx src/scripts/export-content.ts",
    "content:coverage": "tsx src/scripts/report-content-coverage.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "next": "16.4.3",
    "next-intl": "4.14.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.186.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.3",
    "pg": "^8.23.1",
    "pngjs": "^7.0.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
