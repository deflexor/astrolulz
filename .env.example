# ---------------------------------------------------------------------------
# AstralCanvas environment variables (placeholders only — never commit real keys)
# ---------------------------------------------------------------------------

# AI provider — used ONLY by the batch content-generation script.
# The public /api/horoscope endpoint never calls the AI provider.
AI_PROVIDER_API_KEY=
AI_PROVIDER_MODEL=
# Optional override, e.g. a compatible gateway. Defaults to the Anthropic API.
AI_PROVIDER_BASE_URL=

# Supabase — public values. The publishable key is Supabase's current name
# for the legacy "anon" key. Current server code does not read it (content
# is served through this app's own API), so it is optional; only set it if
# direct browser access is ever deliberately added (requires RLS policies).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase — server-only secret. Bypasses RLS; must never reach client code.
# Required for the Supabase content repository and the import/export scripts.
SUPABASE_SERVICE_ROLE_KEY=

# Content source for the horoscope API: "fixtures" (local JSONL files, no
# database required) or "supabase". Defaults to "supabase" in production when
# Supabase variables are present, "fixtures" otherwise.
CONTENT_SOURCE=
